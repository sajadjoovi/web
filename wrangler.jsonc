{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "1e8bbb52-c814-45db-bd2b-3792b6fec763","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "dc5e8ee1ff1249328b7b09f2078aa1ca" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
